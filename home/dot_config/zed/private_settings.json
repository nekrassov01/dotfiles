{
  "agent": {
    "button": true,
    "enabled": true,
    "favorite_models": [],
    "model_parameters": []
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "git-firefly": true,
    "github-theme": true,
    "html": true,
    "markdownlint": true,
    "material-icon-theme": true,
    "pylsp": true,
    "toml": true
  },
  "base_keymap": "VSCode",
  "buffer_font_fallbacks": ["Menlo", "Monaco", "Courier New"],
  "buffer_font_family": "Liga SFMono Nerd Font",
  "buffer_font_features": {
    "calt": false,
    "liga": false
  },
  "buffer_font_size": 18.0,
  "command_palette": {
    "use_command_history": true
  },
  "completions": {
    "words": "disabled"
  },
  "file_types": {
    "bats": ["**/*.bats"],
    "dotenv": ["**/.env*"],
    "go-template": ["**/*.tmpl"],
    "ignore": ["**/git/ignore"],
    "plaintext": ["**/*history", "**/.hushlogin"],
    "properties": [
      "**/*rc",
      "**/.aws/config",
      "**/.shellspec",
      "**/git/attributes",
      "**/git/config"
    ],
    "shellscript": ["**/.bash*"],
    "ssh-config": ["**/.ssh/config", "**/.ssh/include/*"]
  },
  "format_on_save": "on",
  "formatter": "auto",
  "git": {
    "diff_base": "head"
  },
  "git_panel": {
    "dock": "right"
  },
  "gutter": {
    "folds": true
  },
  "icon_theme": "Material Icon Theme",
  "languages": {
    "Go": {
      "tab_size": 8
    }
  },
  "line_ending": "prefer_lf",
  "markdown_preview": {
    "font_size": 20,
    "limit_content_width": true,
    "max_width": 1200
  },
  "minimap": {
    "show": "never"
  },
  "preview_tabs": {
    "enabled": false
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "auto_reveal_entries": false,
    "dock": "right",
    "sort_order": "unicode"
  },
  "semantic_tokens": "combined",
  "session": {
    "trust_all_worktrees": true
  },
  "show_whitespaces": "all",
  "sticky_scroll": {
    "enabled": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "copy_on_select": true,
    "font_fallbacks": ["Menlo", "Monaco", "Courier New"],
    "font_family": "Liga SFMono Nerd Font",
    "font_size": 16.0,
    "max_scroll_history_lines": 2048
  },
  "theme": "GitHub Dark",
  "ui_font_size": 16,
  "vim_mode": true
}
