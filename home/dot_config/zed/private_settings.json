{
  "agent": {
    "play_sound_when_agent_done": "always"
  },
  "audio": {
    "experimental.output_audio_device": "coreaudio:BuiltInSpeakerDevice"
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "git-firefly": true,
    "github-theme": true,
    "golangci-lint": true,
    "html": true,
    "make": true,
    "markdownlint": true,
    "material-icon-theme": true,
    "pylsp": true,
    "toml": true
  },
  "base_keymap": "VSCode",
  "buffer_font_size": 18.0,
  "buffer_font_features": {
    "calt": false
  },
  "completions": {
    "words": "disabled"
  },
  "diff_view_style": "split",
  "format_on_save": "on",
  "git_panel": {
    "dock": "right",
    "entry_primary_click_action": "file_diff"
  },
  "icon_theme": "Material Icon Theme",
  "line_ending": "prefer_lf",
  "markdown_preview": {
    "font_size": 20,
    "max_width": 1200
  },
  "preview_tabs": {
    "enabled": false
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "auto_reveal_entries": false,
    "dock": "right",
    "sort_order": "unicode"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "show_whitespaces": "all",
  "sticky_scroll": {
    "enabled": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "theme": "GitHub Dark",
  "ui_font_size": 18.0,
  "vim_mode": true
}
